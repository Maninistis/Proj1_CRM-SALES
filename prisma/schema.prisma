// Prisma schema for CRM + Sales Management System
// Database: MariaDB (via mysql provider — MariaDB is wire-compatible)
// Driver adapter: @prisma/adapter-mariadb (configured in src/lib/prisma.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// === AUTH.JS v5 ADAPTER MODELS ===

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String    @map("password_hash")
  roleRoleId    String    @map("role_id")
  status        String    @default("ACTIVE")
  managerId     String?   @map("manager_id")
  requirePasswordChange Boolean @default(false) @map("require_password_change")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt       @map("updated_at")

  role              Role                @relation(fields: [roleRoleId], references: [id])
  manager           User?               @relation("UserManager", fields: [managerId], references: [id])
  directReports     User[]              @relation("UserManager")
  accounts          Account[]
  sessions          Session[]
  assignedLeads     Lead[]              @relation("AssignedLeads")
  createdLeads      Lead[]              @relation("CreatedLeads")
  assignedOpportunities Opportunity[]   @relation("AssignedOpportunities")
  createdOpportunities  Opportunity[]   @relation("CreatedOpportunities")
  createdQuotations     Quotation[]     @relation("CreatedQuotations")
  createdCustomers      Customer[]      @relation("CreatedCustomers")
  createdSalesOrders    SalesOrder[]    @relation("CreatedSalesOrders")
  createdDeliveryNotes  DeliveryNote[]  @relation("CreatedDeliveryNotes")
  createdInvoices       SalesInvoice[]  @relation("CreatedInvoices")
  receivedPayments     Payment[]       @relation("ReceivedPayments")

  createdConversations     Conversation[]              @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[]   @relation("ConversationParticipant")
  sentMessages             Message[]                   @relation("SentMessages")
  notifications            Notification[]              @relation("UserNotifications")
  businessMemberships      BusinessUser[]              @relation("BusinessMember")

  @@map("users")
  @@index([roleRoleId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@map("verification_tokens")
  @@unique([identifier, token])
}

// === RBAC MODELS ===

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "leads:create"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@map("role_permissions")
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// === AUDIT LOG ===

model AuditLog {
  id            String   @id @default(cuid())
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String   // CREATE | UPDATE | DELETE | TRANSITION
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  userId        String   @map("user_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// === SETTINGS ===

model Setting {
  id          String   @id @default(cuid())
  key         String
  value       String   @db.Text
  category    String   @default("general")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businessId    String    @map("business_id")

  @@unique([key, businessId])
  @@index([businessId])

  @@map("settings")
}

// === DOCUMENT NUMBER COUNTER ===

model Counter {
  id        String   @id @default(cuid())
  prefix    String
  sequence  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  businessId    String    @map("business_id")

  @@unique([prefix, businessId])
  @@index([businessId])

  @@map("counters")
}

// === CRM — LEAD ===

model Lead {
  id           String    @id @default(cuid())
  documentNo   String    @unique @map("document_no")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String?
  phone        String?
  company      String?
  jobTitle     String?   @map("job_title")
  source       String    @default("OTHER")
  status       String    @default("NEW")
  assignedToId String?   @map("assigned_to_id")
  createdById  String?   @map("created_by_id")
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  assignedTo User? @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy  User? @relation("CreatedLeads", fields: [createdById], references: [id])
  opportunities Opportunity[]
  customer   Customer?         @relation("CustomerLead")

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("leads")
  @@index([status])
  @@index([assignedToId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([createdAt])
}

// === CRM — OPPORTUNITY ===

model Opportunity {
  id                String    @id @default(cuid())
  documentNo        String    @unique @map("document_no")
  leadId            String    @map("lead_id")
  title             String
  description       String?   @db.Text
  estimatedValue    Decimal   @db.Decimal(12, 2) @map("estimated_value")
  expectedCloseDate DateTime  @map("expected_close_date")
  stage             String    @default("PROSPECTING")
  status            String    @default("OPEN")
  lossReason        String?   @map("loss_reason")
  assignedToId      String?   @map("assigned_to_id")
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  lead       Lead  @relation(fields: [leadId], references: [id])
  assignedTo User? @relation("AssignedOpportunities", fields: [assignedToId], references: [id])
  createdBy  User? @relation("CreatedOpportunities", fields: [createdById], references: [id])
  quotations Quotation[]

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("opportunities")
  @@index([leadId])
  @@index([stage])
  @@index([status])
  @@index([assignedToId])
  @@index([deletedAt])
  @@index([createdAt])
}

// === CRM — QUOTATION ===

model Quotation {
  id            String    @id @default(cuid())
  documentNo    String    @unique @map("document_no")
  opportunityId String    @map("opportunity_id")
  status        String    @default("DRAFT")
  subject       String
  validUntil    DateTime  @map("valid_until")
  currency      String    @default("PHP")
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  discountTotal Decimal   @default(0) @db.Decimal(12, 2) @map("discount_total")
  taxRate       Decimal   @default(0) @db.Decimal(5, 4) @map("tax_rate")
  taxTotal      Decimal   @default(0) @db.Decimal(12, 2) @map("tax_total")
  grandTotal    Decimal   @db.Decimal(12, 2) @map("grand_total")
  sentAt        DateTime? @map("sent_at")
  acceptedAt    DateTime? @map("accepted_at")
  notes         String?   @db.Text
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  opportunity Opportunity      @relation(fields: [opportunityId], references: [id])
  createdBy   User?             @relation("CreatedQuotations", fields: [createdById], references: [id])
  items       QuotationItem[]
  salesOrder  SalesOrder?

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("quotations")
  @@index([opportunityId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

model QuotationItem {
  id              String   @id @default(cuid())
  quotationId     String   @map("quotation_id")
  description     String
  quantity        Decimal  @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(12, 2) @map("unit_price")
  discountPercent Decimal  @default(0) @db.Decimal(5, 2) @map("discount_percent")
  lineTotal       Decimal  @default(0) @db.Decimal(12, 2) @map("line_total")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
  @@index([quotationId])
  @@index([deletedAt])
}

// === PRODUCT CATALOG ===

model Product {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  defaultPrice Decimal  @db.Decimal(12, 2) @map("default_price")
  category     String   @default("general")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("products")
  @@index([category])
  @@index([isActive])
}

// === CRM — CUSTOMER ===

model Customer {
  id           String    @id @default(cuid())
  documentNo   String    @unique @map("document_no")
  name         String
  email        String?
  phone        String?
  taxId        String?   @map("tax_id")
  website      String?
  status       String    @default("NEW")
  creditLimit  Decimal?  @db.Decimal(12, 2) @map("credit_limit")
  paymentTerms Int       @default(30) @map("payment_terms")
  leadId       String?   @unique @map("lead_id")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  lead       Lead?             @relation("CustomerLead", fields: [leadId], references: [id])
  createdBy  User?              @relation("CreatedCustomers", fields: [createdById], references: [id])
  contacts   CustomerContact[]
  addresses  CustomerAddress[]
  salesOrders SalesOrder[]
  invoices   SalesInvoice[]
  payments   Payment[]

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("customers")
  @@index([status])
  @@index([deletedAt])
  @@index([email])
  @@index([createdAt])
  @@index([leadId])
}

model CustomerContact {
  id          String    @id @default(cuid())
  customerId  String    @map("customer_id")
  name        String
  email       String?
  phone       String?
  jobTitle    String?   @map("job_title")
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
  @@index([customerId])
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  type        String
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?   @map("postal_code")
  country     String   @default("Philippines")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
  @@index([customerId])
  @@index([type])
}

// === SALES — SALES ORDER ===

model SalesOrder {
  id                   String    @id @default(cuid())
  documentNo           String    @unique @map("document_no")
  customerId           String    @map("customer_id")
  quotationId          String?   @unique @map("quotation_id")
  status               String    @default("AWAITING_PAYMENT")
  orderDate            DateTime  @map("order_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  subtotal             Decimal   @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal   @default(0) @db.Decimal(12, 2) @map("discount_total")
  taxRate              Decimal   @default(0) @db.Decimal(5, 4) @map("tax_rate")
  taxTotal             Decimal   @default(0) @db.Decimal(12, 2) @map("tax_total")
  grandTotal           Decimal   @db.Decimal(12, 2) @map("grand_total")
  notes                String?   @db.Text
  createdById          String?   @map("created_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  customer   Customer          @relation(fields: [customerId], references: [id])
  quotation  Quotation?        @relation(fields: [quotationId], references: [id])
  createdBy  User?             @relation("CreatedSalesOrders", fields: [createdById], references: [id])
  items      SalesOrderItem[]
  deliveryNotes DeliveryNote[]
  invoice    SalesInvoice?

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("sales_orders")
  @@index([customerId])
  @@index([quotationId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

model SalesOrderItem {
  id                String    @id @default(cuid())
  salesOrderId      String    @map("sales_order_id")
  description       String
  quantity          Decimal   @db.Decimal(10, 2)
  unitPrice         Decimal   @db.Decimal(12, 2) @map("unit_price")
  discountPercent   Decimal   @default(0) @db.Decimal(5, 2) @map("discount_percent")
  lineTotal         Decimal   @default(0) @db.Decimal(12, 2) @map("line_total")
  deliveredQuantity Decimal   @default(0) @db.Decimal(10, 2) @map("delivered_quantity")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  salesOrder       SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  deliveryNoteItems DeliveryNoteItem[]

  @@map("sales_order_items")
  @@index([salesOrderId])
  @@index([deletedAt])
}

// === SALES — DELIVERY NOTE ===

model DeliveryNote {
  id              String    @id @default(cuid())
  documentNo      String    @unique @map("document_no")
  salesOrderId    String    @map("sales_order_id")
  status          String    @default("DRAFT")
  deliveryDate    DateTime? @map("delivery_date")
  carrier         String?
  trackingNumber  String?   @map("tracking_number")
  notes           String?   @db.Text
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  salesOrder SalesOrder         @relation(fields: [salesOrderId], references: [id])
  createdBy  User?              @relation("CreatedDeliveryNotes", fields: [createdById], references: [id])
  items      DeliveryNoteItem[]

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("delivery_notes")
  @@index([salesOrderId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

model DeliveryNoteItem {
  id                String   @id @default(cuid())
  deliveryNoteId    String   @map("delivery_note_id")
  salesOrderItemId  String   @map("sales_order_item_id")
  description       String
  quantity          Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  deliveryNote  DeliveryNote   @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])

  @@map("delivery_note_items")
  @@index([deliveryNoteId])
  @@index([salesOrderItemId])
  @@index([deletedAt])
}

// === SALES — INVOICE ===

model SalesInvoice {
  id            String    @id @default(cuid())
  documentNo    String    @unique @map("document_no")
  salesOrderId  String    @unique @map("sales_order_id")
  customerId    String    @map("customer_id")
  customerName  String    @map("customer_name")
  customerEmail String?   @map("customer_email")
  customerPhone String?   @map("customer_phone")
  customerAddress String? @db.Text @map("customer_address")
  status        String    @default("OPEN")
  issueDate     DateTime  @map("issue_date")
  dueDate       DateTime  @map("due_date")
  currency      String    @default("PHP")
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  discountTotal Decimal   @default(0) @db.Decimal(12, 2) @map("discount_total")
  taxRate       Decimal   @default(0) @db.Decimal(5, 4) @map("tax_rate")
  taxTotal      Decimal   @default(0) @db.Decimal(12, 2) @map("tax_total")
  grandTotal    Decimal   @db.Decimal(12, 2) @map("grand_total")
  paidAmount    Decimal   @default(0) @db.Decimal(12, 2) @map("paid_amount")
  paidAt        DateTime? @map("paid_at")
  notes         String?   @db.Text
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  salesOrder SalesOrder         @relation(fields: [salesOrderId], references: [id])
  customer   Customer           @relation(fields: [customerId], references: [id])
  createdBy  User?              @relation("CreatedInvoices", fields: [createdById], references: [id])
  items      SalesInvoiceItem[]
  payments   Payment[]

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("sales_invoices")
  @@index([customerId])
  @@index([salesOrderId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([createdAt])
}

model SalesInvoiceItem {
  id              String   @id @default(cuid())
  salesInvoiceId  String   @map("sales_invoice_id")
  description     String
  quantity        Decimal  @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(12, 2) @map("unit_price")
  discountPercent Decimal  @default(0) @db.Decimal(5, 2) @map("discount_percent")
  lineTotal       Decimal  @default(0) @db.Decimal(12, 2) @map("line_total")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@map("sales_invoice_items")
  @@index([salesInvoiceId])
  @@index([deletedAt])
}

// === SALES — PAYMENT ===

model Payment {
  id              String    @id @default(cuid())
  documentNo      String    @unique @map("document_no")
  salesInvoiceId  String    @map("sales_invoice_id")
  customerId      String    @map("customer_id")
  customerName    String    @map("customer_name")
  amount          Decimal   @db.Decimal(12, 2)
  paymentMethod   String    @map("payment_method")
  referenceNumber String?   @map("reference_number")
  paymentDate     DateTime  @map("payment_date")
  status          String    @default("RECEIVED")
  notes           String?   @db.Text
  proofImageUrl    String?  @map("proof_image_url")
  receivedById    String?   @map("received_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  receivedBy   User?        @relation("ReceivedPayments", fields: [receivedById], references: [id])

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("payments")
  @@index([salesInvoiceId])
  @@index([customerId])
  @@index([status])
  @@index([paymentDate])
  @@index([deletedAt])
  @@index([createdAt])
}

// === MESSAGING ===

model Conversation {
  id            String    @id @default(cuid())
  isGroup       Boolean   @default(false) @map("is_group")
  name          String?
  createdById   String?   @map("created_by_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdBy    User?                    @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("conversations")
  @@index([createdById])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")
  leftAt         DateTime? @map("left_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String    @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// === DOCUMENT SETTINGS (singleton) ===

model DocumentSetting {
  id                String   @id @default(cuid())

  // Company Branding
  logoUrl           String?  @map("logo_url")
  companyName       String?  @map("company_name")
  companyDesc       String?  @map("company_desc")
  addressLine1      String?  @map("address_line1")
  addressLine2      String?  @map("address_line2")
  city              String?
  province          String?
  zipCode           String?  @map("zip_code")
  country           String?
  phone             String?
  mobile            String?
  email             String?
  primaryContact    String?  @map("primary_contact")
  taxRate           String?  @map("tax_rate")
  paymentTermsDays  String?  @map("payment_terms_days")
  website           String?
  facebook          String?
  linkedin          String?
  instagram         String?

  // Document Preferences
  invoicePrefix     String   @default("INV")  @map("invoice_prefix")
  quotationPrefix   String   @default("Q")    @map("quotation_prefix")
  soPrefix          String   @default("SO")   @map("so_prefix")
  deliveryPrefix    String   @default("DN")   @map("delivery_prefix")
  paymentPrefix     String   @default("PAY")  @map("payment_prefix")
  orPrefix          String   @default("OR")   @map("or_prefix")
  startingNumber    Int      @default(1)      @map("starting_number")
  currency          String   @default("PHP")
  dateFormat        String   @default("MMM DD, YYYY") @map("date_format")
  timezone          String   @default("Asia/Manila")
  decimalPlaces     Int      @default(2)      @map("decimal_places")
  paperSize         String   @default("A4")   @map("paper_size")
  orientation       String   @default("portrait")

  // Rich Text Sections
  termsContent      String?  @db.Text @map("terms_content")
  paymentInfo       String?  @db.Text @map("payment_info")
  footerContent     String?  @db.Text @map("footer_content")

  // Signature
  signatureUrl      String?  @map("signature_url")
  signatureName     String?  @map("signature_name")
  signaturePosition String?  @map("signature_position")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt       @map("updated_at")

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("document_settings")
}

model Notification {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  type       String
  title      String
  message    String    @db.Text
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  link       String?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  businessId    String    @map("business_id")

  @@index([businessId])

  @@map("notifications")
  @@index([userId, readAt])
  @@index([createdAt])
}

model Business {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members BusinessUser[]

  @@map("businesses")
}

model BusinessUser {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation("BusinessMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("business_users")
  @@index([userId])
}
