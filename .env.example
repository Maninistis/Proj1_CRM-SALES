# MariaDB connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/crm_sales

# Auth.js JWT signing secret (minimum 32 characters)
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-this-with-a-secure-random-string-at-least-32-chars

# Application base URL
NEXTAUTH_URL=http://localhost:3000
